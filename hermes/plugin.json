{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "courierpr",
  "version": "1.0.0",
  "description": "Read-only press release wire MCP server and skill: browse newsroom desks, list and search published company press releases, and read the opening of one with a link to the full release.",
  "author": {
    "name": "CourierPR",
    "url": "https://courierpr.com"
  },
  "homepage": "https://courierpr.com",
  "repository": "https://github.com/aitrainingdatabroker/courierpr-mcp-server",
  "keywords": ["press releases", "newswire", "company announcements", "news search", "mcp"],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "courierpr": { "trust": "untrusted" }
      }
    }
  }
}
